{
  "manifest_version": 3,
  "name": "Covert Crew in Tab",
  "version": "1.0.0",
  "description": "A tiny family of secret agents and their dachshund live in your browser: they walk, climb, react to your searches and cheer you on.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Covert Crew",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shared.js", "content/art.js", "content/styles.js", "content/engine.js"],
      "run_at": "document_idle"
    }
  ]
}
